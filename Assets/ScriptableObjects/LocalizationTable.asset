  entries:
  - key: order.reject.needs_plate
    translations:
    - language: en
      text: You need a plate
    - language: ru
      text: "\u041D\u0443\u0436\u043D\u0430 \u0442\u0430\u0440\u0435\u043B\u043A\u0430"
  - key: order.reject.empty_plate
    translations:
    - language: en
      text: The plate is empty
    - language: ru
      text: "\u0422\u0430\u0440\u0435\u043B\u043A\u0430 \u043F\u0443\u0441\u0442\u0430\u044F"
  - key: order.reject.not_finished
    translations:
    - language: en
      text: The dish isn't ready
    - language: ru
      text: "\u0411\u043B\u044E\u0434\u043E \u043D\u0435 \u0433\u043E\u0442\u043E\u0432\u043E"
  - key: order.reject.no_such_order
    translations:
    - language: en
      text: No such order
    - language: ru
      text: "\u0422\u0430\u043A\u043E\u0433\u043E \u0437\u0430\u043A\u0430\u0437\u0430
        \u043D\u0435\u0442"
  - key: order.reject.level_too_low
    translations:
    - language: en
      text: Ingredient level is too low
    - language: ru
      text: "\u041D\u0435 \u0442\u043E\u0442 \u0443\u0440\u043E\u0432\u0435\u043D\u044C
        \u043F\u0440\u043E\u0434\u0443\u043A\u0442\u043E\u0432"
